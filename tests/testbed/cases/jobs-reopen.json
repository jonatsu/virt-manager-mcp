[
  {
    "tool": "job_list",
    "args": {
      "vm": "t-w"
    },
    "expect": {
      "matches": "(\"job\": \"[0-9a-f-]{36}\".*){4}",
      "contains": [
        "\"state\": \"running\"",
        "\"state\": \"ended without status\""
      ]
    }
  },
  {
    "tool": "job_read",
    "args": {
      "vm": "t-w",
      "job": "${job1}",
      "max_bytes": 40
    },
    "expect": {
      "contains": [
        "\"next\":40,",
        "\"state\":\"running\"",
        "step 0\nstep 1\n"
      ]
    }
  },
  {
    "tool": "job_stop",
    "args": {
      "vm": "t-w",
      "job": "${job1}"
    },
    "expect": {
      "contains": "sent TERM to job"
    }
  },
  {
    "tool": "__sleep__",
    "args": {
      "secs": 2
    }
  },
  {
    "tool": "job_read",
    "args": {
      "vm": "t-w",
      "job": "${job1}",
      "since": 100000
    },
    "expect": {
      "contains": [
        "\"exit_code\":143",
        "\"state\":\"exited\""
      ]
    }
  },
  {
    "tool": "job_stop",
    "args": {
      "vm": "t-w",
      "job": "${job1}"
    },
    "expect": {
      "error": true,
      "contains": "is not running"
    }
  },
  {
    "tool": "job_read",
    "args": {
      "vm": "t-w",
      "job": "../../../etc"
    },
    "expect": {
      "error": true,
      "contains": "'../../../etc' is not a job ID"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-w",
      "command": "rm -rf /var/lib/virtmanager-mcp && ln -s /tmp /var/lib/virtmanager-mcp && ls -A /tmp"
    },
    "expect": {
      "contains": [
        "\"exit_code\":0",
        ".X11-unix"
      ]
    }
  },
  {
    "tool": "job_start",
    "args": {
      "vm": "t-w",
      "command": "echo should not run"
    },
    "expect": {
      "error": true,
      "contains": "/var/lib/virtmanager-mcp is a symbolic link"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-w",
      "command": "ls -A /tmp"
    },
    "expect": {
      "contains": [
        "\"exit_code\":0",
        ".X11-unix"
      ],
      "absent": [
        "\njobs\n",
        "should not run"
      ]
    }
  },
  {
    "tool": "job_start",
    "args": {
      "vm": "trial-deb13",
      "command": "true"
    },
    "expect": {
      "error": true,
      "contains": "VM 'trial-deb13' is not in allowed_vms"
    }
  },
  {
    "tool": "job_read",
    "args": {
      "vm": "trial-deb13",
      "job": "${job1}"
    },
    "expect": {
      "error": true,
      "contains": "VM 'trial-deb13' is not in allowed_vms"
    }
  },
  {
    "tool": "job_stop",
    "args": {
      "vm": "trial-deb13",
      "job": "${job1}"
    },
    "expect": {
      "error": true,
      "contains": "VM 'trial-deb13' is not in allowed_vms"
    }
  },
  {
    "tool": "job_list",
    "args": {
      "vm": "trial-deb13"
    },
    "expect": {
      "error": true,
      "contains": "VM 'trial-deb13' is not in allowed_vms"
    }
  },
  {
    "tool": "stop_vm",
    "args": {
      "vm": "t-w",
      "force": true
    },
    "expect": {
      "contains": "VM 't-w' is shut off"
    }
  },
  {
    "tool": "delete_vm",
    "args": {
      "vm": "t-w"
    },
    "expect": {
      "contains": [
        "deleted VM 't-w'",
        "t-w-g1.qcow2",
        "t-w-g1-seed.img"
      ]
    }
  }
]
