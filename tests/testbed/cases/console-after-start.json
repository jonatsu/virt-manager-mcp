[
  {
    "tool": "start_vm",
    "args": {
      "vm": "trial-deb13",
      "wait_for_agent_secs": 0
    },
    "expect": {
      "contains": "VM 'trial-deb13': started"
    }
  },
  {
    "tool": "console_open",
    "args": {
      "vm": "trial-deb13"
    },
    "expect": {
      "matches": "console for 'trial-deb13' opened \\(generation \\d+\\)"
    }
  },
  {
    "tool": "console_read",
    "args": {
      "vm": "trial-deb13",
      "wait_ms": 30000,
      "max_bytes": 1
    },
    "expect": {
      "contains": "\"closed\":null"
    }
  },
  {
    "tool": "console_read",
    "args": {
      "vm": "trial-deb13",
      "wait_ms": 30000,
      "max_bytes": 1
    },
    "expect": {
      "contains": "\"closed\":null"
    }
  },
  {
    "tool": "console_read",
    "args": {
      "vm": "trial-deb13",
      "wait_ms": 30000,
      "max_bytes": 1
    },
    "expect": {
      "contains": "\"closed\":null"
    }
  },
  {
    "tool": "console_read",
    "args": {
      "vm": "trial-deb13",
      "wait_ms": 30000,
      "max_bytes": 1
    },
    "expect": {
      "contains": "\"closed\":null"
    }
  },
  {
    "tool": "console_read",
    "args": {
      "vm": "trial-deb13",
      "max_bytes": 500000
    },
    "expect": {
      "contains": [
        "\"closed\":null",
        "GNU GRUB"
      ]
    }
  }
]
