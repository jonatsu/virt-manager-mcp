[
  {
    "tool": "console_open",
    "args": {
      "vm": "trial-deb13",
      "force": true
    },
    "expect": {
      "matches": "console for 'trial-deb13' opened \\(generation \\d+\\)"
    }
  },
  {
    "tool": "console_write",
    "args": {
      "vm": "trial-deb13",
      "text": "root"
    },
    "expect": {
      "contains": "sent 5 bytes"
    }
  },
  {
    "tool": "console_read",
    "args": {
      "vm": "trial-deb13",
      "since": 0,
      "wait_ms": 5000
    },
    "expect": {
      "contains": "Password:"
    }
  },
  {
    "tool": "list_vms",
    "expect": {
      "contains": "\"name\": \"trial-deb13\""
    }
  },
  {
    "tool": "list_vms",
    "expect": {
      "contains": "\"name\": \"trial-deb13\""
    }
  },
  {
    "tool": "list_vms",
    "expect": {
      "contains": "\"name\": \"trial-deb13\""
    }
  },
  {
    "tool": "console_read",
    "args": {
      "vm": "trial-deb13",
      "since": 0,
      "wait_ms": 3000
    },
    "expect": {
      "contains": "Password:"
    }
  },
  {
    "tool": "console_write",
    "args": {
      "vm": "trial-deb13",
      "text": "trial"
    },
    "expect": {
      "contains": "sent 6 bytes"
    }
  },
  {
    "tool": "list_vms",
    "expect": {
      "contains": "\"name\": \"trial-deb13\""
    }
  },
  {
    "tool": "list_vms",
    "expect": {
      "contains": "\"name\": \"trial-deb13\""
    }
  },
  {
    "tool": "console_read",
    "args": {
      "vm": "trial-deb13",
      "since": 0,
      "wait_ms": 3000
    },
    "expect": {
      "contains": [
        "Password:",
        "root@trial-deb13:~#"
      ]
    }
  },
  {
    "tool": "console_close",
    "args": {
      "vm": "trial-deb13"
    },
    "expect": {
      "contains": "console closed"
    }
  }
]
