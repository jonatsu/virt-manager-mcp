[
  {
    "tool": "console_open",
    "args": {
      "vm": "trial-deb13",
      "force": true
    },
    "expect": {
      "matches": "console for 'trial-deb13' opened \\(generation \\d+\\)"
    }
  },
  {
    "tool": "console_write",
    "args": {
      "vm": "trial-deb13",
      "text": ""
    },
    "expect": {
      "contains": "sent 1 bytes"
    }
  },
  {
    "tool": "console_read",
    "args": {
      "vm": "trial-deb13",
      "wait_ms": 3000
    },
    "expect": {
      "contains": "trial-deb13 login:"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "trial-deb13",
      "command": "nohup sh -c 'sleep 2; systemctl poweroff' >/dev/null 2>&1 &"
    },
    "expect": {
      "contains": "\"exit_code\":0"
    }
  },
  {
    "tool": "console_read",
    "args": {
      "vm": "trial-deb13",
      "wait_ms": 30000,
      "max_bytes": 200
    },
    "expect": {
      "contains": "\"generation\":"
    }
  },
  {
    "tool": "console_read",
    "args": {
      "vm": "trial-deb13",
      "wait_ms": 30000,
      "max_bytes": 200
    },
    "expect": {
      "contains": "console stream ended"
    }
  },
  {
    "tool": "list_vms",
    "expect": {
      "contains": "\"state\": \"shutoff\""
    }
  },
  {
    "tool": "start_vm",
    "args": {
      "vm": "trial-deb13",
      "wait_for_agent_secs": 180
    },
    "expect": {
      "contains": "VM 'trial-deb13': started; guest agent is responding"
    }
  },
  {
    "tool": "console_open",
    "args": {
      "vm": "trial-deb13",
      "force": true
    },
    "expect": {
      "matches": "console for 'trial-deb13' opened \\(generation \\d+\\)"
    }
  },
  {
    "tool": "console_write",
    "args": {
      "vm": "trial-deb13",
      "text": ""
    },
    "expect": {
      "contains": "sent 1 bytes"
    }
  },
  {
    "tool": "console_read",
    "args": {
      "vm": "trial-deb13",
      "wait_ms": 3000
    },
    "expect": {
      "contains": "\"closed\":null"
    }
  },
  {
    "tool": "stop_vm",
    "args": {
      "vm": "trial-deb13",
      "force": true
    },
    "expect": {
      "contains": "VM 'trial-deb13' is shut off"
    }
  },
  {
    "tool": "console_read",
    "args": {
      "vm": "trial-deb13",
      "wait_ms": 0
    },
    "expect": {
      "contains": "console stream ended"
    }
  },
  {
    "tool": "start_vm",
    "args": {
      "vm": "trial-deb13",
      "wait_for_agent_secs": 180
    },
    "expect": {
      "contains": "VM 'trial-deb13': started; guest agent is responding"
    }
  },
  {
    "tool": "console_close",
    "args": {
      "vm": "trial-deb13"
    },
    "expect": {
      "contains": "console closed"
    }
  }
]
