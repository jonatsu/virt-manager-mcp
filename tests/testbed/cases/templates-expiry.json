[
  {
    "tool": "create_vm_from_template",
    "args": {
      "name": "t-exp",
      "template": "debian13",
      "lifetime_minutes": 1,
      "wait_for_agent_secs": 0
    },
    "expect": {
      "contains": [
        "created VM 't-exp' from template 'debian13'",
        "in 1 minutes"
      ]
    }
  },
  {
    "tool": "attach_disk",
    "args": {
      "vm": "t-exp",
      "size_gib": 1
    },
    "expect": {
      "contains": "attached new 1 GiB disk agent-vms/t-exp-vdc.qcow2 to 't-exp' as vdc"
    }
  },
  {
    "tool": "create_vm_from_template",
    "args": {
      "name": "t-keep",
      "template": "debian13",
      "start": false
    },
    "expect": {
      "contains": [
        "created VM 't-keep' from template 'debian13'",
        "it does not expire"
      ]
    }
  },
  {
    "tool": "__time__"
  },
  {
    "tool": "__sleep__",
    "args": {
      "secs": 130
    }
  },
  {
    "tool": "__time__"
  },
  {
    "tool": "list_vms",
    "args": {},
    "expect": {
      "contains": [
        "\"name\": \"t-keep\"",
        "\"name\": \"t-listed\""
      ],
      "absent": "\"name\": \"t-exp\""
    }
  },
  {
    "tool": "delete_vm",
    "args": {
      "vm": "t-keep"
    },
    "expect": {
      "contains": [
        "deleted VM 't-keep'",
        "t-keep-g1.qcow2",
        "t-keep-g1-seed.img"
      ]
    }
  }
]
