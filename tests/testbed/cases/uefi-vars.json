[
  {
    "tool": "create_vm",
    "args": {
      "name": "t-uv",
      "os": "linux",
      "vcpus": 1,
      "memory_mib": 512,
      "disk_gib": 1,
      "firmware": "uefi",
      "secure_boot": false
    },
    "expect": {
      "contains": "created VM 't-uv' (1 vCPUs, 512 MiB, 1 GiB disk agent-vms/t-uv.qcow2, UEFI without Secure Boot"
    }
  },
  {
    "tool": "describe_vm",
    "args": {
      "vm": "t-uv"
    },
    "expect": {
      "contains": [
        "\"firmware\": \"uefi\"",
        "\"secure_boot_mode\": \"off\""
      ]
    }
  }
]
