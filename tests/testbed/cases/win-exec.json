[
  {
    "tool": "start_vm",
    "args": {
      "vm": "t-win11",
      "wait_for_agent_secs": 300
    },
    "expect": {
      "contains": "guest agent is responding"
    }
  },
  {
    "tool": "vm_stats",
    "args": {
      "vm": "t-win11"
    },
    "expect": {
      "contains": [
        "\"state\": \"running\"",
        "\"type\": \"NTFS\"",
        "they are the guest's own claim",
        "the VM has no memory balloon device"
      ]
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-win11",
      "command": "whoami"
    },
    "expect": {
      "contains": "nt authority\\system",
      "absent": "CLIXML"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-win11",
      "command": "whoami",
      "shell": "cmd"
    },
    "expect": {
      "contains": "nt authority\\system"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-win11",
      "command": "(Get-CimInstance Win32_OperatingSystem).Caption; Confirm-SecureBootUEFI; (Get-Tpm).TpmPresent; (Get-CimInstance Win32_PnPSignedDriver | Where-Object { $_.DeviceName -like '*VirtIO Serial*' }).IsSigned"
    },
    "expect": {
      "matches": "Windows 11 Pro\\s+True\\s+True\\s+True",
      "absent": "CLIXML"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-win11",
      "program": "cmd.exe",
      "args": [
        "/c",
        "echo",
        "\u00e9t\u00e9"
      ]
    },
    "expect": {
      "error": true,
      "contains": "not ASCII; use `command`"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-win11",
      "command": "$env:X",
      "env": [
        "X=\u00e9t\u00e9"
      ]
    },
    "expect": {
      "error": true,
      "contains": "`env` entry that is not ASCII"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-win11",
      "command": "echo \u00e9t\u00e9"
    },
    "expect": {
      "contains": "\u00e9t\u00e9",
      "absent": "CLIXML"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-win11",
      "command": "Write-Output before; Get-Item C:\\vmm-\u00e9t\u00e9-nope; Write-Output after; exit 3"
    },
    "expect": {
      "contains": [
        "\"exit_code\":3",
        "before",
        "after",
        "Cannot find path 'C:\\vmm-\u00e9t\u00e9-nope'"
      ],
      "absent": "CLIXML"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-win11",
      "command": "Write-Output x; cmd /c exit 5"
    },
    "expect": {
      "contains": "\"exit_code\":1,",
      "absent": "CLIXML"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-win11",
      "command": "Get-Item C:\\nope"
    },
    "expect": {
      "contains": [
        "\"exit_code\":1,",
        "Cannot find path"
      ],
      "absent": "CLIXML"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-win11",
      "command": "Get-Item C:\\nope; 'after'"
    },
    "expect": {
      "contains": [
        "\"exit_code\":0,",
        "after"
      ],
      "absent": "CLIXML"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-win11",
      "command": "cmd /c exit 5 `"
    },
    "expect": {
      "contains": "\"exit_code\":1,",
      "absent": "CLIXML"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-win11",
      "command": "if ("
    },
    "expect": {
      "contains": [
        "\"exit_code\":1,",
        "Missing closing ')'"
      ],
      "absent": "CLIXML"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-win11",
      "command": "$input | ForEach-Object { 'in:' + $_ }",
      "stdin": "abc\ndef\n"
    },
    "expect": {
      "contains": [
        "\"exit_code\":0,",
        "in:abc",
        "in:def"
      ]
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-win11",
      "command": "'all:' + [Console]::In.ReadToEnd()",
      "stdin": "xyz"
    },
    "expect": {
      "contains": [
        "\"exit_code\":0,",
        "all:xyz"
      ]
    }
  },
  {
    "tool": "write_file",
    "args": {
      "vm": "t-win11",
      "path": "C:\\Windows\\Temp\\vmm-roundtrip.txt",
      "content": "round trip\n"
    },
    "expect": {
      "contains": "wrote 11 bytes"
    }
  },
  {
    "tool": "read_file",
    "args": {
      "vm": "t-win11",
      "path": "C:\\Windows\\Temp\\vmm-roundtrip.txt"
    },
    "expect": {
      "contains": "round trip"
    }
  },
  {
    "tool": "stop_vm",
    "args": {
      "vm": "t-win11"
    },
    "expect": {
      "contains": "VM 't-win11' is shut off"
    }
  }
]
