[
  {
    "tool": "reset_vm",
    "args": {
      "vm": "t-s"
    },
    "expect": {
      "error": true,
      "contains": "template volume 'tpl-scratch.qcow2' is not in pool 'agent-vms'"
    }
  },
  {
    "tool": "describe_vm",
    "args": {
      "vm": "t-s"
    },
    "expect": {
      "contains": [
        "t-s-g1.qcow2",
        "t-s-g1-seed.img",
        "\"state\": \"running\""
      ],
      "absent": "t-s-g2"
    }
  },
  {
    "tool": "stop_vm",
    "args": {
      "vm": "t-s",
      "force": true
    },
    "expect": {
      "contains": "VM 't-s' is shut off"
    }
  },
  {
    "tool": "delete_vm",
    "args": {
      "vm": "t-s"
    },
    "expect": {
      "contains": [
        "deleted VM 't-s'",
        "t-s-g1.qcow2",
        "t-s-g1-seed.img"
      ]
    }
  },
  {
    "tool": "stop_vm",
    "args": {
      "vm": "t-r",
      "force": true
    },
    "expect": {
      "contains": "VM 't-r' is shut off"
    }
  },
  {
    "tool": "delete_vm",
    "args": {
      "vm": "t-r"
    },
    "expect": {
      "contains": [
        "deleted VM 't-r'",
        "t-r-g2.qcow2",
        "t-r-g2-seed.img"
      ]
    }
  },
  {
    "tool": "delete_vm",
    "args": {
      "vm": "t-plain"
    },
    "expect": {
      "contains": [
        "deleted VM 't-plain'",
        "t-plain.qcow2"
      ]
    }
  }
]
