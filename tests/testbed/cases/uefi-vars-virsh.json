[
  {
    "tool": "create_vm",
    "args": {
      "name": "t-uvv",
      "os": "linux",
      "vcpus": 1,
      "memory_mib": 512,
      "disk_gib": 1,
      "firmware": "uefi",
      "secure_boot": "setup"
    },
    "expect": {
      "contains": "created VM 't-uvv' (1 vCPUs, 512 MiB, 1 GiB disk agent-vms/t-uvv.qcow2, UEFI with Secure Boot in setup mode"
    }
  },
  {
    "tool": "describe_vm",
    "args": {
      "vm": "t-uvv"
    },
    "expect": {
      "contains": "\"secure_boot_mode\": \"setup\""
    }
  }
]
