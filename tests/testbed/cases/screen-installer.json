[
  {
    "tool": "start_vm",
    "args": {
      "vm": "t-inst",
      "wait_for_agent_secs": 0
    },
    "expect": {
      "contains": "VM 't-inst': started"
    }
  },
  {
    "tool": "wait_for",
    "args": {
      "vm": "t-inst",
      "timeout_secs": 60,
      "screenshot": true,
      "conditions": [
        {
          "kind": "screen_text",
          "pattern": "Graphical install"
        }
      ]
    },
    "expect": {
      "contains": [
        "\"result\":\"matched\"",
        "\"text\":\"Graphical install\""
      ],
      "matches": "\"screenshot\":\\{(?=[^}]*\"width\":\\d+)(?=[^}]*\"height\":\\d+)[^}]*\\}.*\\n<image saved to shot-\\d+\\.png>$"
    }
  },
  {
    "tool": "send_keys",
    "args": {
      "vm": "t-inst",
      "keys": [
        "enter"
      ]
    },
    "expect": {
      "contains": "sent 1 key combo(s)"
    }
  },
  {
    "tool": "wait_for",
