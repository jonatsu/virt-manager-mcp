[
  {
    "tool": "create_vm_from_template",
    "args": {
      "name": "t-w",
      "template": "debian13",
      "wait_for_agent_secs": 120
    },
    "expect": {
      "contains": [
        "created VM 't-w' from template 'debian13'",
        "guest agent is responding"
      ]
    }
  },
  {
    "tool": "job_start",
    "args": {
      "vm": "t-w",
      "command": "i=0; while [ $i -lt 600 ]; do echo step $i; i=$((i+1)); sleep 1; done"
    },
    "save": {
      "job1": "job"
    },
    "expect": {
      "contains": "started with systemd-run"
    }
  },
  {
    "tool": "__sleep__",
    "args": {
      "secs": 3
    }
  },
  {
    "tool": "job_read",
    "args": {
      "vm": "t-w",
      "job": "${job1}"
    },
    "expect": {
      "contains": [
        "\"state\":\"running\"",
        "step 0\nstep 1\nstep 2\n"
      ]
    }
  },
  {
    "tool": "__sleep__",
    "args": {
      "secs": 2
    }
  },
  {
    "tool": "job_read",
    "args": {
      "vm": "t-w",
      "job": "${job1}"
    },
    "expect": {
      "contains": [
        "\"state\":\"running\"",
        "step 4\n"
      ]
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-w",
      "command": "nohup sh -c 'sleep 1; systemctl restart qemu-guest-agent' >/dev/null 2>&1 &"
    },
    "expect": {
      "contains": "\"exit_code\":0"
    }
  },
  {
    "tool": "__sleep__",
    "args": {
      "secs": 5
    }
  },
  {
    "tool": "job_read",
    "args": {
      "vm": "t-w",
      "job": "${job1}",
      "since": 20
    },
    "expect": {
      "contains": [
        "\"state\":\"running\"",
        "step 8\n"
      ]
    }
  },
  {
    "tool": "job_start",
    "args": {
      "vm": "t-w",
      "command": "printf '%s|%s\\n' '$HOME' \"it's \\\"quoted\\\"\"; echo \"${NOT_SET:-literal braces}\""
    },
    "save": {
      "job2": "job"
    },
    "expect": {
      "contains": "started with systemd-run"
    }
  },
  {
    "tool": "__sleep__",
    "args": {
      "secs": 2
    }
  },
  {
    "tool": "job_read",
    "args": {
      "vm": "t-w",
      "job": "${job2}"
    },
    "expect": {
      "contains": [
        "\"exit_code\":0",
        "\"state\":\"exited\"",
        "$HOME|it's \"quoted\"\nliteral braces\n"
      ]
    }
  },
  {
    "tool": "job_start",
    "args": {
      "vm": "t-w",
      "command": "yes | head -c 10"
    },
    "save": {
      "pipe": "job"
    },
    "expect": {
      "contains": "started with systemd-run"
    }
  },
  {
    "tool": "__sleep__",
    "args": {
      "secs": 2
    }
  },
  {
    "tool": "job_read",
    "args": {
      "vm": "t-w",
      "job": "${pipe}"
    },
    "expect": {
      "contains": [
        "\"exit_code\":0",
        "\"next\":10,",
        "\"state\":\"exited\"",
        "y\ny\ny\ny\ny"
      ]
    }
  },
  {
    "tool": "job_start",
    "args": {
      "vm": "t-w",
      "command": "sleep 300"
    },
    "save": {
      "job3": "job"
    },
    "expect": {
      "contains": "started with systemd-run"
    }
  },
  {
    "tool": "__sleep__",
    "args": {
      "secs": 2
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-w",
      "command": "kill -9 $(cut -d ' ' -f 1 /var/lib/virtmanager-mcp/jobs/${job3}/pid)"
    },
    "expect": {
      "contains": "\"exit_code\":0"
    }
  },
  {
    "tool": "job_read",
    "args": {
      "vm": "t-w",
      "job": "${job3}"
    },
    "expect": {
      "contains": [
        "\"exit_code\":null",
        "\"state\":\"ended without status\""
      ]
    }
  },
  {
    "tool": "job_list",
    "args": {
      "vm": "t-w"
    },
    "expect": {
      "matches": "(\"job\": \"[0-9a-f-]{36}\".*){4}",
      "contains": [
        "\"state\": \"running\"",
        "\"state\": \"ended without status\""
      ]
    }
  }
]
