[
  {
    "tool": "start_vm",
    "args": {
      "vm": "t-owrt",
      "wait_for_agent_secs": 0
    },
    "expect": {
      "contains": "VM 't-owrt': started"
    }
  },
  {
    "tool": "console_open",
    "args": {
      "vm": "t-owrt"
    },
    "expect": {
      "matches": "console for 't-owrt' opened \\(generation \\d+\\)"
    }
  },
  {
    "tool": "__sleep__",
    "args": {
      "secs": 25
    }
  },
  {
    "tool": "console_write",
    "args": {
      "vm": "t-owrt",
      "text": ""
    },
    "expect": {
      "contains": "sent 1 bytes"
    }
  },
  {
    "tool": "console_read",
    "args": {
      "vm": "t-owrt",
      "since": 0,
      "wait_ms": 3000,
      "max_bytes": 300000
    },
    "expect": {
      "contains": [
        "Please press Enter to activate this console",
        "root@OpenWrt:~#"
      ]
    }
  },
  {
    "tool": "console_close",
    "args": {
      "vm": "t-owrt"
    },
    "expect": {
      "contains": "console closed"
    }
  },
  {
    "tool": "stop_vm",
    "args": {
      "vm": "t-owrt",
      "force": true
    },
    "expect": {
      "contains": "VM 't-owrt' is shut off"
    }
  }
]
