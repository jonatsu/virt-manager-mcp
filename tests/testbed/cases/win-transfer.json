[
  {
    "tool": "copy_to_vm",
    "args": {
      "vm": "t-win11",
      "host_path": "${share}/win.txt",
      "guest_path": "C:\\Windows\\Temp\\vmm-win.txt"
    },
    "expect": {
      "contains": "copied 17 bytes"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-win11",
      "command": "(Get-FileHash C:\\Windows\\Temp\\vmm-win.txt).Hash"
    },
    "expect": {
      "contains": "11F6F2D560D80FC6A1294533DC8EAF04D4C49E24A54EC1CB797D11DC229FC125"
    }
  },
  {
    "tool": "copy_from_vm",
    "args": {
      "vm": "t-win11",
      "guest_path": "C:\\Windows\\Temp\\vmm-win.txt",
      "host_path": "${pull}/win/vmm-win.txt"
    },
    "expect": {
      "contains": "copied 17 bytes"
    }
  },
  {
    "tool": "vm_addresses",
    "args": {
      "vm": "t-win11"
    },
    "expect": {
      "contains": "\"interfaces\":[]"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-win11",
      "command": "foreach ($d in (@('vmm-\u00e9t\u00e9', 'vmm-\u00e9t\u00e9-file', 'vmm-jp') | ForEach-Object { Join-Path (Join-Path $env:SystemRoot 'Temp') $_ }) + (@('vmm-acl', 'vmm-ref') | ForEach-Object { Join-Path $env:PUBLIC $_ })) { if (Test-Path -LiteralPath $d) { Remove-Item -LiteralPath \"\\\\?\\$d\" -Recurse -Force } }\n$t = Join-Path $env:SystemRoot 'Temp'\nforeach ($d in 'vmm-tree', 'vmm-wintree', 'vmm-sentinel', 'vmm-deep') { if (Test-Path -LiteralPath \"$t\\$d\") { Remove-Item -LiteralPath \"\\\\?\\$t\\$d\" -Recurse -Force } }\n[void](New-Item -ItemType Directory \"$t\\vmm-sentinel\")\nSet-Content -LiteralPath \"$t\\vmm-sentinel\\keep.txt\" -Value keep\n'ready'"
    },
    "expect": {
      "contains": "ready"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-win11",
      "command": "chcp\nNew-Item -ItemType File -Force (Join-Path $env:SystemRoot \"Temp\\vmm-\u00e9t\u00e9-file\") | Out-Null\n\"made\""
    },
    "expect": {
      "contains": [
        "Active code page: 437",
        "made"
      ]
    }
  },
  {
    "tool": "copy_dir_to_vm",
    "args": {
      "vm": "t-win11",
      "host_path": "${tree}",
      "guest_path": "C:\\Windows\\Temp\\vmm-\u00e9t\u00e9-file\\sub"
    },
    "expect": {
      "error": true,
      "contains": "C:\\Windows\\Temp\\vmm-\u00e9t\u00e9-file\" because",
      "absent": "\ufffd"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-win11",
      "command": "Remove-Item -LiteralPath (Join-Path $env:SystemRoot \"Temp\\vmm-\u00e9t\u00e9-file\") -Force\n\"gone\""
    },
    "expect": {
      "contains": "gone"
    }
  },
  {
    "tool": "copy_dir_to_vm",
    "args": {
      "vm": "t-win11",
      "host_path": "${tree}",
      "guest_path": "C:\\Windows\\Temp\\vmm-tree"
    },
    "expect": {
      "contains": [
        "\"files\":4",
        "\"symlinks\":0",
        "\"ignored\":3",
        "link-in",
        "link-out",
        "pipe"
      ]
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-win11",
      "command": "$t = Join-Path $env:SystemRoot 'Temp\\vmm-tree'\nGet-ChildItem -LiteralPath $t -Recurse -File -Force | Sort-Object FullName | ForEach-Object { $_.FullName.Substring($t.Length + 1) + ' ' + (Get-FileHash -LiteralPath $_.FullName).Hash + ' ro=' + $_.IsReadOnly }\n'link-in: ' + (Test-Path -LiteralPath \"$t\\link-in\")"
    },
    "expect": {
      "contains": [
        "a.txt B6A98D9CE9A2D9149288FA3DF42D377C3E42737AFDCDAF714E33C0A100B51060 ro=False",
        "sub\\b.txt F2C82DECDD7181CF98945929A62598DB7E6B477E11F6E0EB0AE97020EFF151AD ro=False",
        "sub\\run.sh 299001868FB8C02FD431C336C6D058F5558C5DFF5B5AF5E6FE04B870A6A9CBBA ro=False",
        ".gitignore E8522379883074C5CD12E6FCCD10874864EA2AF56C82AC33CCB34E858535D07D ro=False",
        "link-in: False"
      ],
      "absent": "ro=True"
    }
  },
  {
    "tool": "copy_dir_to_vm",
    "args": {
      "vm": "t-win11",
      "host_path": "${tree}",
      "guest_path": "C:\\Windows\\Temp\\vmm-tree"
    },
    "expect": {
      "error": true,
      "contains": "pass replace: true"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-win11",
      "command": "$t = Join-Path $env:SystemRoot 'Temp'\ncmd /c mklink /J \"$t\\vmm-tree\\link\" \"$t\\vmm-sentinel\"\nSet-Content -LiteralPath \"$t\\vmm-tree\\old-only.txt\" -Value old"
    },
    "expect": {
      "contains": "Junction created"
    }
  },
  {
    "tool": "copy_dir_to_vm",
    "args": {
      "vm": "t-win11",
      "host_path": "${tree}",
      "guest_path": "C:\\Windows\\Temp\\vmm-tree",
      "replace": true
    },
    "expect": {
      "contains": "\"files\":4"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-win11",
      "command": "$t = Join-Path $env:SystemRoot 'Temp'\n'keep=' + (Test-Path -LiteralPath \"$t\\vmm-sentinel\\keep.txt\")\n'old=' + (Test-Path -LiteralPath \"$t\\vmm-tree\\old-only.txt\")\n'link=' + (Test-Path -LiteralPath \"$t\\vmm-tree\\link\")\n'new=' + (Test-Path -LiteralPath \"$t\\vmm-tree\\a.txt\")"
    },
    "expect": {
      "contains": [
        "keep=True",
        "old=False",
        "link=False",
        "new=True"
      ]
    }
  },
  {
    "tool": "copy_dir_to_vm",
    "args": {
      "vm": "t-win11",
      "host_path": "${tree}",
      "guest_path": "C:\\"
    },
    "expect": {
      "error": true,
      "contains": "a push never replaces C:\\"
    }
  },
  {
    "tool": "copy_dir_to_vm",
    "args": {
      "vm": "t-win11",
      "host_path": "${tree}",
      "guest_path": "c:\\windows\\",
      "replace": true
    },
    "expect": {
      "error": true,
      "contains": "replace refuses C:\\ and the directories directly below it"
    }
  },
  {
    "tool": "copy_dir_to_vm",
    "args": {
      "vm": "t-win11",
      "host_path": "${tree}",
      "guest_path": "C:\\Windows.",
      "replace": true
    },
    "expect": {
      "error": true,
      "contains": "ends in a dot or a space"
    }
  },
  {
    "tool": "copy_dir_to_vm",
    "args": {
      "vm": "t-win11",
      "host_path": "${tree}",
      "guest_path": "\\\\server\\share\\x"
    },
    "expect": {
      "error": true,
      "contains": "UNC and device paths"
    }
  },
  {
    "tool": "copy_dir_to_vm",
    "args": {
      "vm": "t-win11",
      "host_path": "${share}/win-tree",
      "guest_path": "C:\\Windows\\Temp\\vmm-wintree"
    },
    "expect": {
      "contains": [
        "\"files\":4",
        "\"path\":\"CON\"",
        "\"path\":\"nul.txt\"",
        "\"path\":\"a?b\"",
        "\"path\":\"tail.\"",
        "\"path\":\"case.txt\"",
        "\"path\":\"aux\"",
        "\"path\":\"link-in\"",
        "only in case",
        "device name reserved"
      ],
      "absent": "aux/inner.txt"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-win11",
      "command": "$t = Join-Path $env:SystemRoot 'Temp\\vmm-wintree'\n(Get-ChildItem -LiteralPath $t -Recurse -Force | Sort-Object FullName | ForEach-Object { $_.FullName.Substring($t.Length + 1) }) -join '|'"
    },
    "expect": {
      "contains": [
        "Case.txt",
        "ok.txt",
        "sub\\deep.txt",
        "\u00e9t\u00e9.txt"
      ],
      "absent": [
        "case.txt",
        "CON",
        "nul.txt",
        "a?b",
        "tail",
        "aux",
        "link-in"
      ]
    }
  },
  {
    "tool": "copy_dir_from_vm",
    "args": {
      "vm": "t-win11",
      "guest_path": "C:\\Windows\\Temp\\vmm-tree",
      "host_path": "${pull}/win-dir"
    },
    "expect": {
      "contains": [
        "\"files\":4",
        "\"skipped\":[]"
      ]
    }
  },
  {
    "tool": "job_start",
    "args": {
      "vm": "t-win11",
      "command": "$fs = [IO.File]::Open((Join-Path $env:SystemRoot 'Temp\\vmm-tree\\a.txt'), 'Open', 'ReadWrite', 'None'); 'held'; Start-Sleep 120; $fs.Close()"
    },
    "save": {
      "held": "job"
    },
    "expect": {
      "contains": "\"job\""
    }
  },
  {
    "tool": "wait_for",
    "args": {
      "vm": "t-win11",
      "timeout_secs": 60,
      "conditions": [
        {
          "kind": "job_output",
          "job": "${held}",
          "pattern": "held"
        }
      ]
    },
    "expect": {
      "contains": "\"result\":\"matched\""
    }
  },
  {
    "tool": "copy_dir_to_vm",
    "args": {
      "vm": "t-win11",
      "host_path": "${tree}",
      "guest_path": "C:\\Windows\\Temp\\vmm-tree",
      "replace": true
    },
    "expect": {
      "error": true,
      "contains": [
        "usually because a file in it is open",
        "the old tree is unchanged"
      ]
    }
  },
  {
    "tool": "job_stop",
    "args": {
      "vm": "t-win11",
      "job": "${held}"
    },
    "expect": {
      "contains": "ended job"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-win11",
      "command": "$t = Join-Path $env:SystemRoot 'Temp'\n'a=' + (Get-FileHash -LiteralPath \"$t\\vmm-tree\\a.txt\").Hash\n'vmm=' + (Get-ChildItem -Force -LiteralPath $t -Filter '.vmm-*' | Measure-Object).Count\n'tar=' + (Get-Process -Name tar -ErrorAction SilentlyContinue | Measure-Object).Count"
    },
    "expect": {
      "contains": [
        "a=B6A98D9CE9A2D9149288FA3DF42D377C3E42737AFDCDAF714E33C0A100B51060",
        "vmm=0",
        "tar=0"
      ]
    }
  },
  {
    "tool": "copy_dir_to_vm",
    "args": {
      "vm": "t-win11",
      "host_path": "${share}/win-deep",
      "guest_path": "C:\\Windows\\Temp\\vmm-deep"
    },
    "expect": {
      "contains": "\"files\":1"
    }
  },
  {
    "tool": "copy_dir_to_vm",
    "args": {
      "vm": "t-win11",
      "host_path": "${share}/win-deep",
      "guest_path": "C:\\Windows\\Temp\\vmm-deep",
      "replace": true
    },
    "expect": {
      "contains": "\"files\":1",
      "absent": "note"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-win11",
      "command": "$t = Join-Path $env:SystemRoot 'Temp'\n$f = Get-ChildItem -LiteralPath \"\\\\?\\$t\\vmm-deep\" -Recurse -File\n'deep=' + ($f.FullName.Length - 4) + ' ' + (Get-Content -LiteralPath $f.FullName)\n'vmm=' + (Get-ChildItem -Force -LiteralPath $t -Filter '.vmm-*' | Measure-Object).Count"
    },
    "expect": {
      "contains": [
        "deep=288 deep",
        "vmm=0"
      ]
    }
  },
  {
    "tool": "job_start",
    "args": {
      "vm": "t-win11",
      "command": "$pub = $env:PUBLIC\n$sids = { param($acl) ($acl.Access | ForEach-Object { $_.IdentityReference.Translate([Security.Principal.SecurityIdentifier]).Value } | Sort-Object -Unique) -join ',' }\n'watching'\n$end = (Get-Date).AddSeconds(90)\nwhile ((Get-Date) -lt $end) {\n  $d = Get-ChildItem -LiteralPath $pub -Directory -Force -Filter '.vmm-*.a' -ErrorAction SilentlyContinue | Select-Object -First 1\n  if ($d) {\n    $a = Get-Acl -LiteralPath $d.FullName\n    'dir protected=' + $a.AreAccessRulesProtected + ' rules=' + (& $sids $a)\n    $t = Join-Path $d.FullName 'push.tar'\n    $wait = (Get-Date).AddSeconds(20)\n    while (-not (Test-Path -LiteralPath $t) -and (Get-Date) -lt $wait) { Start-Sleep -Milliseconds 10 }\n    'tar rules=' + (& $sids (Get-Acl -LiteralPath $t))\n    exit 0\n  }\n  Start-Sleep -Milliseconds 10\n}\n'not seen'\n"
    },
    "save": {
      "watch": "job"
    },
    "expect": {
      "contains": "\"job\""
    }
  },
  {
    "tool": "wait_for",
    "args": {
      "vm": "t-win11",
      "timeout_secs": 60,
      "conditions": [
        {
          "kind": "job_output",
          "job": "${watch}",
          "pattern": "watching"
        }
      ]
    },
    "expect": {
      "contains": "\"result\":\"matched\""
    }
  },
  {
    "tool": "copy_dir_to_vm",
    "args": {
      "vm": "t-win11",
      "host_path": "${share}/win-ete",
      "guest_path": "C:\\Users\\Public\\vmm-acl"
    },
    "expect": {
      "contains": "\"files\":2"
    }
  },
  {
    "tool": "wait_for",
    "args": {
      "vm": "t-win11",
      "timeout_secs": 60,
      "conditions": [
        {
          "kind": "job_done",
          "job": "${watch}"
        }
      ]
    },
    "expect": {
      "contains": "\"result\":\"matched\""
    }
  },
  {
    "tool": "job_read",
    "args": {
      "vm": "t-win11",
      "job": "${watch}"
    },
    "expect": {
      "contains": [
        "dir protected=True rules=S-1-5-18,S-1-5-32-544",
        "tar rules=S-1-5-18,S-1-5-32-544"
      ],
      "absent": "not seen"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-win11",
      "command": "\"vmm=\" + (Get-ChildItem -Force -LiteralPath $env:PUBLIC -Filter \".vmm-*\" | Measure-Object).Count"
    },
    "expect": {
      "contains": "vmm=0"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-win11",
      "command": "$p = Join-Path $env:PUBLIC 'vmm-ref'\n[void](New-Item -ItemType Directory $p)\nSet-Content -LiteralPath \"$p\\a.txt\" -Value a\nSet-Content -LiteralPath \"$p\\\u00e9t\u00e9.txt\" -Value e\n# The rules of a pushed tree and of one made in place, compared by value: icacls prints names in another code page.\nfunction Rules($d) { foreach ($r in '', '\\a.txt', '\\\u00e9t\u00e9.txt') { $a = Get-Acl -LiteralPath \"$d$r\"; \"$r protected=$($a.AreAccessRulesProtected)\"; $a.Access | ForEach-Object { \"$r $($_.IdentityReference) $($_.FileSystemRights) $($_.InheritanceFlags) $($_.PropagationFlags) inherited=$($_.IsInherited)\" } } }\n$pushed = Rules (Join-Path $env:PUBLIC 'vmm-acl')\n$made = Rules $p\nif (Compare-Object $pushed $made) { 'acl=differs'; $pushed; '--'; $made } else { 'acl=same' }\n$pushed -match 'INTERACTIVE'"
    },
    "expect": {
      "contains": [
        "acl=same",
        "\\a.txt NT AUTHORITY\\INTERACTIVE DeleteSubdirectoriesAndFiles, Modify, Synchronize None None inherited=True"
      ]
    }
  },
  {
    "tool": "copy_dir_to_vm",
    "args": {
      "vm": "t-win11",
      "host_path": "${share}/win-ete",
      "guest_path": "C:\\Windows\\Temp\\vmm-\u00e9t\u00e9"
    },
    "expect": {
      "contains": "\"files\":2"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-win11",
      "command": "$d = Join-Path $env:SystemRoot 'Temp\\vmm-\u00e9t\u00e9'\nforeach ($f in 'a.txt', '\u00e9t\u00e9.txt') { $f + '=' + (Get-FileHash -LiteralPath \"$d\\$f\").Hash }"
    },
    "expect": {
      "contains": [
        "a.txt=87428FC522803D31065E7BCE3CF03FE475096631E5E07BBD7A0FDE60C4CF25C7",
        "\u00e9t\u00e9.txt=AC68EA8C75B70BBDAB368D1D15DEFD92DBAC45088A633FE8BAB3355CB895DD77"
      ]
    }
  },
  {
    "tool": "copy_dir_from_vm",
    "args": {
      "vm": "t-win11",
      "guest_path": "C:\\Windows\\Temp\\vmm-\u00e9t\u00e9",
      "host_path": "${pull}/win-ete"
    },
    "expect": {
      "contains": [
        "\"files\":2",
        "\"skipped\":[]"
      ]
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-win11",
      "command": "$d = Join-Path $env:SystemRoot 'Temp\\vmm-jp'\n[void](New-Item -ItemType Directory $d)\nSet-Content -LiteralPath \"$d\\\u65e5\u672c.txt\" -Value j\n'made'"
    },
    "expect": {
      "contains": "made"
    }
  },
  {
    "tool": "copy_dir_from_vm",
    "args": {
      "vm": "t-win11",
      "guest_path": "C:\\Windows\\Temp\\vmm-jp",
      "host_path": "${pull}/win-jp"
    },
    "expect": {
      "error": true,
      "contains": [
        "exit status 255",
        "ANSI code page"
      ]
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-win11",
      "command": "$t = Join-Path $env:SystemRoot 'Temp'\n$dirs = @('vmm-tree', 'vmm-wintree', 'vmm-sentinel', 'vmm-win.txt', 'vmm-deep', 'vmm-\u00e9t\u00e9', 'vmm-jp' | ForEach-Object { Join-Path $t $_ }) + @('vmm-acl', 'vmm-ref' | ForEach-Object { Join-Path $env:PUBLIC $_ })\nforeach ($d in $dirs) { if (Test-Path -LiteralPath $d) { Remove-Item -LiteralPath \"\\\\?\\$d\" -Recurse -Force } }\n'left=' + ($dirs | Where-Object { Test-Path -LiteralPath $_ }).Count + ' vmm=' + (Get-ChildItem -Force -LiteralPath $t, $env:PUBLIC -Filter '.vmm-*' | Measure-Object).Count"
    },
    "expect": {
      "contains": "left=0 vmm=0"
    }
  }
]
