[
  {
    "tool": "create_vm_from_template",
    "args": {
      "name": "t-w",
      "template": "debian13",
      "wait_for_agent_secs": 0
    },
    "expect": {
      "contains": "created VM 't-w' from template 'debian13'",
      "absent": "guest agent is responding"
    }
  },
  {
    "tool": "console_open",
    "args": {
      "vm": "t-w"
    },
    "expect": {
      "matches": "console for 't-w' opened \\(generation \\d+\\)"
    }
  },
  {
    "tool": "wait_for",
    "args": {
      "vm": "t-w",
      "conditions": [
        {
          "kind": "agent"
        }
      ]
    },
    "expect": {
      "contains": [
        "\"kind\":\"agent\",\"result\":\"matched\"",
        "the guest agent answered"
      ]
    }
  },
  {
    "tool": "console_write",
    "args": {
      "vm": "t-w",
      "text": ""
    },
    "expect": {
      "contains": "sent 1 bytes"
    }
  },
  {
    "tool": "wait_for",
    "args": {
      "vm": "t-w",
      "conditions": [
        {
          "kind": "console",
          "pattern": "login:"
        }
      ]
    },
    "expect": {
      "matches": "\"generation\":\\d+,\"index\":0,\"kind\":\"console\",\"next\":\\d+,\"result\":\"matched\",\"text\":\"login:\""
    }
  },
  {
    "tool": "console_read",
    "args": {
      "vm": "t-w",
      "max_bytes": 200
    },
    "expect": {
      "contains": "t-w login:"
    }
  },
  {
    "tool": "wait_for",
    "args": {
      "vm": "t-w",
      "timeout_secs": 3,
      "conditions": [
        {
          "kind": "console",
          "pattern": "login:"
        }
      ]
    },
    "expect": {
      "matches": "\"result\":\"timed_out\",\"resume\":\\[\\{\"generation\":\\d+,\"index\":0,\"since\":\\d+\\}\\]"
    }
  },
  {
    "tool": "wait_for",
    "args": {
      "vm": "t-w",
      "timeout_secs": 5,
      "conditions": [
        {
          "kind": "console",
          "pattern": "marker-42"
        },
        {
          "kind": "command",
          "command": "test -e /tmp/ready"
        }
      ]
    },
    "expect": {
      "matches": "\"commands\":\\[\\{\"index\":1,\"last_exit_code\":1,.*\"result\":\"timed_out\",\"resume\":\\[\\{\"generation\":\\d+,\"index\":0,\"since\":\\d+\\}\\]"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-w",
      "command": "touch /tmp/ready; echo marker-42 > /dev/ttyS0"
    },
    "expect": {
      "contains": "\"exit_code\":0"
    }
  },
  {
    "tool": "wait_for",
    "args": {
      "vm": "t-w",
      "timeout_secs": 10,
      "conditions": [
        {
          "kind": "command",
          "command": "test -e /tmp/ready && echo ready"
        }
      ]
    },
    "expect": {
      "contains": [
        "\"kind\":\"command\",\"result\":\"matched\"",
        "\"text\":\"ready\\n\""
      ]
    }
  },
  {
    "tool": "wait_for",
    "args": {
      "vm": "t-w",
      "timeout_secs": 5,
      "conditions": [
        {
          "kind": "console",
          "pattern": "marker-\\d+"
        }
      ]
    },
    "expect": {
      "contains": [
        "\"result\":\"matched\"",
        "\"text\":\"marker-42\""
      ]
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-w",
      "command": "nohup sh -c 'sleep 3; echo c > /proc/sysrq-trigger' >/dev/null 2>&1 &"
    },
    "expect": {
      "contains": "\"exit_code\":0"
    }
  },
  {
    "tool": "__time__"
  },
  {
    "tool": "wait_for",
    "args": {
      "vm": "t-w",
      "conditions": [
        {
          "kind": "console",
          "pattern": "login:"
        },
        {
          "kind": "console",
          "pattern": "Kernel panic"
        },
        {
          "kind": "command",
          "command": "false"
        }
      ]
    },
    "expect": {
      "contains": [
        "\"index\":1,\"kind\":\"console\"",
        "\"result\":\"matched\"",
        "\"text\":\"Kernel panic\""
      ]
    }
  },
  {
    "tool": "__time__"
  },
  {
    "tool": "stop_vm",
    "args": {
      "vm": "t-w",
      "force": true
    },
    "expect": {
      "contains": "VM 't-w' is shut off"
    }
  },
  {
    "tool": "start_vm",
    "args": {
      "vm": "t-w",
      "wait_for_agent_secs": 120
    },
    "expect": {
      "contains": "VM 't-w': started; guest agent is responding"
    }
  },
  {
    "tool": "console_open",
    "args": {
      "vm": "t-w",
      "force": true
    },
    "expect": {
      "matches": "console for 't-w' opened \\(generation \\d+\\)"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-w",
      "command": "nohup sh -c 'sleep 5; poweroff' >/dev/null 2>&1 &"
    },
    "expect": {
      "contains": "\"exit_code\":0"
    }
  },
  {
    "tool": "__time__"
  },
  {
    "tool": "wait_for",
    "args": {
      "vm": "t-w",
      "conditions": [
        {
          "kind": "console",
          "pattern": "this never appears"
        }
      ]
    },
    "expect": {
      "contains": [
        "\"result\":\"closed\"",
        "console stream ended"
      ]
    }
  },
  {
    "tool": "__time__"
  },
  {
    "tool": "start_vm",
    "args": {
      "vm": "t-w",
      "wait_for_agent_secs": 120
    },
    "expect": {
      "contains": "VM 't-w': started; guest agent is responding"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-w",
      "command": "nohup sh -c 'sleep 5; poweroff' >/dev/null 2>&1 &"
    },
    "expect": {
      "contains": "\"exit_code\":0"
    }
  },
  {
    "tool": "__time__"
  },
  {
    "tool": "wait_for",
    "args": {
      "vm": "t-w",
      "conditions": [
        {
          "kind": "command",
          "command": "false"
        }
      ]
    },
    "expect": {
      "contains": [
        "\"result\":\"closed\"",
        "the VM is not running"
      ]
    }
  },
  {
    "tool": "__time__"
  },
  {
    "tool": "wait_for",
    "args": {
      "vm": "trial-deb13",
      "conditions": [
        {
          "kind": "agent"
        }
      ]
    },
    "expect": {
      "error": true,
      "contains": "VM 'trial-deb13' is not in allowed_vms"
    }
  },
  {
    "tool": "wait_for",
    "args": {
      "vm": "t-w",
      "conditions": [
        {
          "kind": "console",
          "pattern": "("
        }
      ]
    },
    "expect": {
      "error": true,
      "contains": "bad pattern"
    }
  },
  {
    "tool": "stop_vm",
    "args": {
      "vm": "t-w",
      "force": true
    },
    "expect": {
      "contains": "VM 't-w' is shut off"
    }
  },
  {
    "tool": "delete_vm",
    "args": {
      "vm": "t-w"
    },
    "expect": {
      "contains": [
        "deleted VM 't-w'",
        "t-w-g1.qcow2",
        "t-w-g1-seed.img"
      ]
    }
  }
]
