[
  {
    "tool": "create_vm_from_template",
    "args": {
      "name": "t-w",
      "template": "debian13",
      "wait_for_agent_secs": 120
    },
    "expect": {
      "contains": [
        "created VM 't-w' from template 'debian13'",
        "guest agent is responding"
      ]
    }
  },
  {
    "tool": "console_open",
    "args": {
      "vm": "t-w"
    },
    "expect": {
      "matches": "console for 't-w' opened \\(generation \\d+\\)"
    }
  },
  {
    "tool": "job_start",
    "args": {
      "vm": "t-w",
      "command": "i=0; while [ $i -lt 30 ]; do echo step $i; i=$((i+1)); sleep 1; done"
    },
    "save": {
      "steps": "job"
    },
    "expect": {
      "contains": "started with systemd-run"
    }
  },
  {
    "tool": "__time__"
  },
  {
    "tool": "wait_for",
    "args": {
      "vm": "t-w",
      "conditions": [
        {
          "kind": "job_output",
          "job": "${steps}",
          "pattern": "step 3"
        },
        {
          "kind": "console",
          "pattern": "Kernel panic"
        }
      ]
    },
    "expect": {
      "matches": "\"index\":0,\"kind\":\"job_output\",\"next\":\\d+,\"result\":\"matched\",\"text\":\"step 3\""
    }
  },
  {
    "tool": "__time__"
  },
  {
    "tool": "job_start",
    "args": {
      "vm": "t-w",
      "command": "sleep 3; exit 5"
    },
    "save": {
      "short": "job"
    },
    "expect": {
      "contains": "started with systemd-run"
    }
  },
  {
    "tool": "wait_for",
    "args": {
      "vm": "t-w",
      "conditions": [
        {
          "kind": "job_done",
          "job": "${short}"
        }
      ]
    },
    "expect": {
      "contains": [
        "\"result\":\"matched\"",
        "\"text\":\"exited with code 5\""
      ]
    }
  },
  {
    "tool": "job_start",
    "args": {
      "vm": "t-w",
      "command": "printf a; yes \u00e9 | tr -d \"\\n\" | head -c 1200000; printf \"\\nstep 3\\n\""
    },
    "save": {
      "long": "job"
    },
    "expect": {
      "contains": "started with systemd-run"
    }
  },
  {
    "tool": "wait_for",
    "args": {
      "vm": "t-w",
      "conditions": [
        {
          "kind": "job_output",
          "job": "${long}",
          "pattern": "step 3"
        }
      ]
    },
    "expect": {
      "contains": [
        "\"result\":\"matched\"",
        "\"text\":\"step 3\""
      ]
    }
  },
  {
    "tool": "wait_for",
    "args": {
      "vm": "t-w",
      "timeout_secs": 3,
      "conditions": [
        {
          "kind": "job_output",
          "job": "${steps}",
          "pattern": "never printed"
        }
      ]
    },
    "expect": {
      "matches": "\"result\":\"timed_out\",\"resume\":\\[\\{\"index\":0,\"since\":\\d+\\}\\]",
      "absent": "generation"
    }
  },
  {
    "tool": "wait_for",
    "args": {
      "vm": "t-w",
      "conditions": [
        {
          "kind": "job_done",
          "job": "00000000-0000-4000-8000-000000000000"
        }
      ]
    },
    "expect": {
      "error": true,
      "contains": "no job 00000000-0000-4000-8000-000000000000 in this guest"
    }
  },
  {
    "tool": "stop_vm",
    "args": {
      "vm": "t-w",
      "force": true
    },
    "expect": {
      "contains": "VM 't-w' is shut off"
    }
  },
  {
    "tool": "delete_vm",
    "args": {
      "vm": "t-w"
    },
    "expect": {
      "contains": [
        "deleted VM 't-w'",
        "t-w-g1.qcow2",
        "t-w-g1-seed.img"
      ]
    }
  }
]
