[
  {
    "tool": "start_vm",
    "args": {
      "vm": "t-owrt",
      "wait_for_agent_secs": 0
    },
    "expect": {
      "contains": "VM 't-owrt': started"
    }
  },
  {
    "tool": "console_open",
    "args": {
      "vm": "t-owrt"
    },
    "expect": {
      "matches": "console for 't-owrt' opened \\(generation \\d+\\)"
    }
  },
  {
    "tool": "wait_for",
    "args": {
      "vm": "t-owrt",
      "conditions": [
        {
          "kind": "console",
          "pattern": "Please press Enter to activate this console"
        }
      ]
    },
    "expect": {
      "contains": [
        "\"result\":\"matched\"",
        "\"text\":\"Please press Enter to activate this console\""
      ]
    }
  },
  {
    "tool": "console_write",
    "args": {
      "vm": "t-owrt",
      "text": ""
    },
    "expect": {
      "contains": "sent 1 bytes"
    }
  },
  {
    "tool": "wait_for",
    "args": {
      "vm": "t-owrt",
      "conditions": [
        {
          "kind": "console",
          "pattern": "root@\\S+:\\S*# "
        }
      ]
    },
    "expect": {
      "contains": [
        "\"result\":\"matched\"",
        "\"text\":\"root@(none):~# \""
      ]
    }
  },
  {
    "tool": "console_close",
    "args": {
      "vm": "t-owrt"
    },
    "expect": {
      "contains": "console closed"
    }
  },
  {
    "tool": "stop_vm",
    "args": {
      "vm": "t-owrt",
      "force": true
    },
    "expect": {
      "contains": "VM 't-owrt' is shut off"
    }
  }
]
