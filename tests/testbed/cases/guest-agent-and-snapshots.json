[
  {
    "tool": "exec",
    "args": {
      "vm": "trial-deb13",
      "command": "hostname; uname -r; id; echo err >&2; exit 3"
    },
    "expect": {
      "contains": [
        "\"exit_code\":3",
        "trial-deb13",
        "uid=0(root)",
        "--- stderr ---\nerr"
      ]
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "trial-deb13",
      "program": "/bin/echo",
      "args": [
        "a b",
        "$(id)",
        ";rm -rf /"
      ]
    },
    "expect": {
      "contains": [
        "\"exit_code\":0",
        "a b $(id) ;rm -rf /"
      ]
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "trial-deb13",
      "command": "sleep 30; echo late",
      "timeout_secs": 3
    },
    "expect": {
      "contains": [
        "\"timed_out\":true",
        "did not finish within 3s"
      ],
      "absent": "late"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "trial-deb13",
      "command": "cat",
      "stdin": "piped stdin\n"
    },
    "expect": {
      "contains": [
        "\"exit_code\":0",
        "--- stdout ---\npiped stdin"
      ]
    }
  },
  {
    "tool": "write_file",
    "args": {
      "vm": "trial-deb13",
      "path": "/tmp/hello.txt",
      "content": "hello from mcp\n"
    },
    "expect": {
      "contains": "wrote 15 bytes to /tmp/hello.txt"
    }
  },
  {
    "tool": "write_file",
    "args": {
      "vm": "trial-deb13",
      "path": "/tmp/hello.txt",
      "content": "line two\n",
      "append": true
    },
    "expect": {
      "contains": "wrote 9 bytes to /tmp/hello.txt"
    }
  },
  {
    "tool": "read_file",
    "args": {
      "vm": "trial-deb13",
      "path": "/tmp/hello.txt"
    },
    "expect": {
      "contains": "hello from mcp\nline two"
    }
  },
  {
    "tool": "stat_path",
    "args": {
      "vm": "trial-deb13",
      "path": "/tmp/hello.txt"
    },
    "expect": {
      "contains": [
        "\"type\": \"file\"",
        "\"size\": 24"
      ]
    }
  },
  {
    "tool": "list_dir",
    "args": {
      "vm": "trial-deb13",
      "path": "/tmp/it's a dir; touch /tmp/pwned"
    },
    "expect": {
      "error": true,
      "contains": "can't cd to /tmp/it's a dir; touch /tmp/pwned"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "trial-deb13",
      "command": "ls /tmp/pwned 2>&1"
    },
    "expect": {
      "contains": [
        "\"exit_code\":2",
        "cannot access '/tmp/pwned'"
      ]
    }
  },
  {
    "tool": "read_file",
    "args": {
      "vm": "trial-deb13",
      "path": "/etc/os-release",
      "max_bytes": 80
    },
    "expect": {
      "contains": [
        "\"truncated\":true",
        "PRETTY_NAME=\"Debian GNU/Linux 13 (trixie)\""
      ]
    }
  },
  {
    "tool": "guest_info",
    "args": {
      "vm": "trial-deb13"
    },
    "expect": {
      "contains": [
        "\"host-name\": \"trial-deb13\"",
        "\"version-id\": \"13\""
      ]
    }
  },
  {
    "tool": "snapshot_create",
    "args": {
      "vm": "trial-deb13",
      "snapshot": "clean",
      "description": "before marker"
    },
    "expect": {
      "contains": "created snapshot 'clean' of 'trial-deb13'"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "trial-deb13",
      "command": "echo marker > /root/marker && sync && cat /root/marker"
    },
    "expect": {
      "contains": [
        "\"exit_code\":0",
        "--- stdout ---\nmarker"
      ]
    }
  },
  {
    "tool": "snapshot_list",
    "args": {
      "vm": "trial-deb13"
    },
    "expect": {
      "contains": [
        "\"name\": \"clean\"",
        "\"description\": \"before marker\""
      ]
    }
  },
  {
    "tool": "snapshot_revert",
    "args": {
      "vm": "trial-deb13",
      "snapshot": "clean"
    },
    "expect": {
      "contains": "reverted 'trial-deb13' to snapshot 'clean'; the VM is now running"
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "trial-deb13",
      "command": "ls /root/marker 2>&1; uptime"
    },
    "expect": {
      "contains": "cannot access '/root/marker'"
    }
  },
  {
    "tool": "snapshot_delete",
    "args": {
      "vm": "trial-deb13",
      "snapshot": "clean"
    },
    "expect": {
      "contains": "deleted snapshot 'clean' of 'trial-deb13'"
    }
  },
  {
    "tool": "snapshot_list",
    "args": {
      "vm": "trial-deb13"
    },
    "expect": {
      "matches": "^\\[\\]$"
    }
  }
]
