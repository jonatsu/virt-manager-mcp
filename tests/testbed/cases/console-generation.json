[
  {
    "tool": "create_vm_from_template",
    "args": {
      "name": "t-g",
      "template": "debian13",
      "wait_for_agent_secs": 0
    },
    "expect": {
      "contains": "created VM 't-g' from template 'debian13'"
    }
  },
  {
    "tool": "console_open",
    "args": {
      "vm": "t-g"
    },
    "expect": {
      "matches": "console for 't-g' opened \\(generation \\d+\\)"
    }
  },
  {
    "tool": "__sleep__",
    "args": {
      "secs": 20
    }
  },
  {
    "tool": "console_write",
    "args": {
      "vm": "t-g",
      "text": ""
    },
    "expect": {
      "contains": "sent 1 bytes"
    }
  },
  {
    "tool": "console_read",
    "args": {
      "vm": "t-g",
      "since": 0,
      "wait_ms": 3000
    },
    "expect": {
      "contains": [
        "\"closed\":null",
        "Linux version"
      ]
    }
  },
  {
    "tool": "console_open",
    "args": {
      "vm": "t-g",
      "force": true
    },
    "expect": {
      "matches": "console for 't-g' opened \\(generation \\d+\\)"
    }
  },
  {
    "tool": "console_read",
    "args": {
      "vm": "t-g",
      "since": 10,
      "generation": 1
    },
    "expect": {
      "error": true,
      "contains": "offset from an earlier console session (generation 1"
    }
  },
  {
    "tool": "console_read",
    "args": {
      "vm": "t-g",
      "since": 10
    },
    "expect": {
      "error": true,
      "contains": "since 10 needs the generation of the read that returned it"
    }
  },
  {
    "tool": "console_read",
    "args": {
      "vm": "t-g",
      "since": 0
    },
    "expect": {
      "matches": "\"closed\":null,\"dropped_bytes\":0,\"generation\":\\d+,\"next\":\\d+"
    }
  },
  {
    "tool": "snapshot_create",
    "args": {
      "vm": "t-g",
      "snapshot": "s1"
    },
    "expect": {
      "contains": "created snapshot 's1' of 't-g'"
    }
  },
  {
    "tool": "snapshot_revert",
    "args": {
      "vm": "t-g",
      "snapshot": "s1"
    },
    "expect": {
      "contains": [
        "reverted 't-g' to snapshot 's1'",
        "its console session was closed"
      ]
    }
  },
  {
    "tool": "console_read",
    "args": {
      "vm": "t-g",
      "since": 0
    },
    "expect": {
      "error": true,
      "contains": "no console open for 't-g'"
    }
  },
  {
    "tool": "stop_vm",
    "args": {
      "vm": "t-g",
      "force": true
    },
    "expect": {
      "contains": "VM 't-g' is shut off"
    }
  },
  {
    "tool": "delete_vm",
    "args": {
      "vm": "t-g"
    },
    "expect": {
      "contains": [
        "deleted VM 't-g'",
        "t-g-g1.qcow2",
        "t-g-g1-seed.img"
      ]
    }
  }
]
