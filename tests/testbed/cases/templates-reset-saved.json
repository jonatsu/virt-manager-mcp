[
  {
    "tool": "reset_vm",
    "args": {
      "vm": "t-u"
    },
    "expect": {
      "contains": [
        "reset VM 't-u' to template 'debian13-uefi' (generation 3)",
        "guest agent is responding"
      ]
    }
  },
  {
    "tool": "exec",
    "args": {
      "vm": "t-u",
      "command": "test -d /sys/firmware/efi && echo uefi; hostname"
    },
    "expect": {
      "contains": "uefi\nt-u\n"
    }
  },
  {
    "tool": "create_vm",
    "args": {
      "name": "t-u-g4",
      "os": "linux",
      "vcpus": 1,
      "memory_mib": 256,
      "disk_gib": 1
    },
    "expect": {
      "contains": "created VM 't-u-g4'"
    }
  },
  {
    "tool": "console_open",
    "args": {
      "vm": "t-u"
    },
    "expect": {
      "matches": "console for 't-u' opened \\(generation \\d+\\)"
    }
  },
  {
    "tool": "reset_vm",
    "args": {
      "vm": "t-u"
    },
    "expect": {
      "error": true,
      "contains": [
        "volume 't-u-g4.qcow2' already exists in the disk pool",
        "nothing was changed"
      ]
    }
  },
  {
    "tool": "console_write",
    "args": {
      "vm": "t-u",
      "text": ""
    },
    "expect": {
      "contains": "sent 1 bytes"
    }
  },
  {
    "tool": "console_read",
    "args": {
      "vm": "t-u",
      "since": 0,
      "wait_ms": 3000
    },
    "expect": {
      "matches": "\"closed\":null,.*\"next\":[1-9]"
    }
  },
  {
    "tool": "console_close",
    "args": {
      "vm": "t-u"
    },
    "expect": {
      "contains": "console closed"
    }
  },
  {
    "tool": "list_vms",
    "args": {},
    "expect": {
      "matches": "\"name\": \"t-u\",\\s+\"os\": \"linux\",\\s+\"power_control\": true,\\s+\"state\": \"running\""
    }
  },
  {
    "tool": "describe_vm",
    "args": {
      "vm": "t-u"
    },
    "expect": {
      "contains": [
        "t-u-g3.qcow2",
        "t-u-g3-seed.img",
        "\"firmware\": \"uefi\""
      ],
      "absent": "t-u-g4"
    }
  },
  {
    "tool": "delete_vm",
    "args": {
      "vm": "t-u-g4"
    },
    "expect": {
      "contains": [
        "deleted VM 't-u-g4'",
        "t-u-g4.qcow2"
      ]
    }
  },
  {
    "tool": "stop_vm",
    "args": {
      "vm": "t-u",
      "force": true
    },
    "expect": {
      "contains": "VM 't-u' is shut off"
    }
  },
  {
    "tool": "delete_vm",
    "args": {
      "vm": "t-u"
    },
    "expect": {
      "contains": [
        "deleted VM 't-u'",
        "t-u-g3.qcow2",
        "t-u-g3-seed.img"
      ]
    }
  }
]
