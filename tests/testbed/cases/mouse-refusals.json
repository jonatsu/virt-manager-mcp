[
  {
    "tool": "start_vm",
    "args": {
      "vm": "t-owrt",
      "wait_for_agent_secs": 0
    },
    "expect": {
      "contains": "VM 't-owrt': started"
    }
  },
  {
    "tool": "mouse",
    "args": {
      "vm": "t-owrt",
      "action": "click",
      "x": 10,
      "y": 10,
      "image_width": 1280,
      "image_height": 800
    },
    "expect": {
      "error": true,
      "contains": "VM 't-owrt' has no USB tablet"
    }
  },
  {
    "tool": "mouse",
    "args": {
      "vm": "trial-deb13",
      "action": "click",
      "x": 10,
      "y": 10,
      "image_width": 1280,
      "image_height": 800
    },
    "expect": {
      "error": true,
      "contains": "VM 'trial-deb13' is not in allowed_vms"
    }
  },
  {
    "tool": "stop_vm",
    "args": {
      "vm": "t-owrt",
      "force": true
    },
    "expect": {
      "contains": "VM 't-owrt' is shut off"
    }
  }
]
