[
  {
    "tool": "create_vm_from_template",
    "args": {
      "name": "t-exp2",
      "template": "debian13",
      "lifetime_minutes": 1,
      "start": false
    },
    "expect": {
      "contains": [
        "created VM 't-exp2' from template 'debian13'",
        "in 1 minutes",
        "it is shut off"
      ]
    }
  },
  {
    "tool": "attach_disk",
    "args": {
      "vm": "t-exp2",
      "size_gib": 1
    },
    "expect": {
      "contains": "attached new 1 GiB disk agent-vms/t-exp2-vdc.qcow2 to 't-exp2' as vdc"
    }
  }
]
